  <url value="https://basanovase.github.io/paramedic-handover-ig/CapabilityStatement/ParamedicHandoverReceiver"/>
  <version value="0.1.0"/>
  <name value="ParamedicHandoverReceiver"/>
  <title value="Paramedic Handover Receiver"/>
  <status value="draft"/>
  <date value="2026-10-05"/>
  <publisher value="Basal (Flynn McLean)"/>
  <contact>
    <name value="Basal (Flynn McLean)"/>
    <telecom>
      <system value="url"/>
      <value value="https://basal.com.au"/>
    </telecom>
  </contact>
  <description value="Server capabilities an emergency department FHIR server needs to accept paramedic handovers and run the admissions review queue."/>
  <kind value="requirements"/>
  <fhirVersion value="4.0.1"/>
  <format value="json"/>
  <rest>
    <mode value="server"/>
    <documentation value="Handovers arrive as one transaction Bundle (ParamedicHandoverBundle). Writes go through a SMART-on-FHIR proxy that checks scopes per Bundle entry."/>
    <security>
      <service>
        <coding>
          <system value="http://terminology.hl7.org/CodeSystem/restful-security-service"/>
          <code value="SMART-on-FHIR"/>
        </coding>
      </service>
    </security>
    <resource>
      <type value="Patient"/>
      <supportedProfile value="http://hl7.org.au/fhir/core/StructureDefinition/au-core-patient"/>
      <interaction>
        <code value="read"/>
      </interaction>
      <interaction>
        <code value="create"/>
      </interaction>
      <conditionalCreate value="true"/>
    </resource>
    <resource>
      <type value="Encounter"/>
      <supportedProfile value="https://basanovase.github.io/paramedic-handover-ig/StructureDefinition/paramedic-handover-encounter"/>
      <interaction>
        <code value="read"/>
      </interaction>
      <interaction>
        <code value="update"/>
      </interaction>
    </resource>
    <resource>
      <type value="Task"/>
      <supportedProfile value="https://basanovase.github.io/paramedic-handover-ig/StructureDefinition/handover-admit-task"/>
      <interaction>
        <code value="read"/>
      </interaction>
      <interaction>
        <code value="update"/>
      </interaction>
      <interaction>
        <code value="search-type"/>
      </interaction>
      <searchParam>
        <name value="code"/>
        <definition value="http://hl7.org/fhir/SearchParameter/Task-code"/>
        <type value="token"/>
      </searchParam>
      <searchParam>
        <name value="status"/>
        <definition value="http://hl7.org/fhir/SearchParameter/Task-status"/>
        <type value="token"/>
      </searchParam>
    </resource>
    <resource>
      <type value="DocumentReference"/>
      <supportedProfile value="https://basanovase.github.io/paramedic-handover-ig/StructureDefinition/handover-transcript"/>
      <interaction>
        <code value="read"/>
      </interaction>
    </resource>
    <interaction>
      <code value="transaction"/>
    </interaction>
    <operation>
      <name value="validate"/>
      <definition value="http://hl7.org/fhir/OperationDefinition/Resource-validate"/>
    </operation>
  </rest>
</CapabilityStatement>